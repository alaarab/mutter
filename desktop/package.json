{
  "name": "mutter-desktop",
  "productName": "Mutter",
  "version": "0.1.0",
  "description": "Mutter as a desktop app: the web client and its bridge in one window, no browser policies, no admin.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "author": "alaarab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test:persistence": "node --test test/persistence.test.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.alaarab.mutter",
    "productName": "Mutter",
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "security.js",
      "picker-preload.cjs",
      "package.json",
      "node_modules/uiohook-napi/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "app/**",
          "src/**",
          "bridge/**",
          "vendor/rnnoise/COPYING",
          "!**/*.test.mjs"
        ]
      },
      {
        "from": "../design/fonts",
        "to": "design/fonts"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "artifactName": "${productName}-${version}-win-setup.exe",
      "createDesktopShortcut": true,
      "shortcutName": "Mutter",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
